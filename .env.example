# ---- Supabase: obrigatórias ----
# Painel → Settings → API
SUPABASE_PROJECT_ID=seu-project-ref
SUPABASE_URL=https://seu-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-anonima

VITE_SUPABASE_PROJECT_ID=seu-project-ref
VITE_SUPABASE_URL=https://seu-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anonima

# Origem do app (redirect de recuperação de senha). Em produção: https://seu-dominio.com
# APP_URL=http://localhost:8080
# VITE_APP_URL=http://localhost:8080

# ---- Somente servidor: NUNCA versionar valores reais ----
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=

# ---- E-mail transacional (Resend) — server-only ----
# Sem estas vars, sendTransactionalEmail retorna skipped (não quebra o fluxo).
# 1) Crie API key em https://resend.com/api-keys
# 2) Verifique o domínio em https://resend.com/domains (SPF/DKIM no DNS)
# 3) EMAIL_FROM deve usar esse domínio verificado
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Templo Virtual <noreply@seudominio.com.br>"

# Destinatários das notificações da Comissão de Tecnologia (opcional)
# TECH_COMMISSION_EMAILS=voce@exemplo.com,outro@exemplo.com
# TECH_COMMISSION_CONTACTS_JSON=[{"name":"Nome","role":"Cargo","email":"voce@exemplo.com","phone":"","phoneTel":""}]
